@model _25dh110973_LTW.Models.Product
@{ViewBag.Title=Model.ProductName;Layout="~/Views/Shared/_CustomerLayout.cshtml";}<div class="row"><div class="col-md-5"><img class="product-photo" src="@Url.Content(String.IsNullOrWhiteSpace(Model.ProductImage)?"~/Content/Images/no-image.png":(Model.ProductImage.StartsWith("~")?Model.ProductImage:"~/Content/Images/"+Model.ProductImage))" onerror="this.style.display='none'"/></div><div class="col-md-7"><h2>@Model.ProductName</h2><p>Danh mục: @(Model.Category==null?"":Model.Category.CategoryName)</p><p class="price">@Model.ProductPrice.ToString("N0") đ</p><p>@Model.ProductDecription</p>@using(Html.BeginForm("Add","Cart",FormMethod.Post)){@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.ProductID"/><label>Số lượng <input type="number" name="quantity" value="1" min="1" max="99" class="form-control" style="width:90px"/></label><p><button type="submit" class="btn btn-primary">Thêm vào giỏ hàng</button></p>}</div></div>