@model _25dh110973_LTW.Models.ViewModel.ShopHomeVM
@using PagedList.Mvc
@{ViewBag.Title="Trang chủ";Layout="~/Views/Shared/_CustomerLayout.cshtml";}<section class="hero"><h1>Chào mừng đến MyStore</h1><p>Mua sắm dễ dàng, sản phẩm đa dạng</p><a class="btn btn-primary" href="#products">Bắt đầu mua sắm</a></section><h2>Tìm kiếm sản phẩm</h2>@using(Html.BeginForm("Index","Home",FormMethod.Get,new{@class="form-inline"})){<input class="form-control" name="search" value="@Model.Search" placeholder="Tên, mô tả hoặc danh mục"/><select class="form-control" name="sort"><option value="">Mới nhất</option><option value="price_asc" @(Model.Sort=="price_asc"?"selected":"")>Giá tăng dần</option><option value="price_desc" @(Model.Sort=="price_desc"?"selected":"")>Giá giảm dần</option><option value="name" @(Model.Sort=="name"?"selected":"")>Tên A-Z</option></select><button class="btn btn-primary">Tìm kiếm</button>}@if(String.IsNullOrEmpty(Model.Search)){<h2>Sản phẩm nổi bật</h2>@Html.Partial("~/Views/Shared/_ProductCards.cshtml",Model.FeaturedProducts)}<h2 id="products">Sản phẩm</h2>@Html.Partial("~/Views/Shared/_ProductCards.cshtml",Model.Products)@Html.PagedListPager(Model.Products,p=>Url.Action("Index",new{page=p,search=Model.Search,sort=Model.Sort}))