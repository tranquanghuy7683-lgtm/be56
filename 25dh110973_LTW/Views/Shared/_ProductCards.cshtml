@model IEnumerable<_25dh110973_LTW.Models.Product>
<div class="row">@foreach(var p in Model){<div class="col-sm-6 col-md-4"><div class="product-card"><a href="@Url.Action("ProductDetail","Home",new{id=p.ProductID})"><img src="@Url.Content(String.IsNullOrWhiteSpace(p.ProductImage)?"~/Content/Images/no-image.png":(p.ProductImage.StartsWith("~")?p.ProductImage:"~/Content/Images/"+p.ProductImage))" onerror="this.style.display='none'" alt="Sản phẩm"/><h4 class="product-title">@p.ProductName</h4></a><div class="price">@p.ProductPrice.ToString("N0") đ</div><p>@(p.Category==null?"":p.Category.CategoryName)</p>@using(Html.BeginForm("Add","Cart",FormMethod.Post)){@Html.AntiForgeryToken()<input type="hidden" name="id" value="@p.ProductID"/><button class="btn btn-primary" type="submit">Thêm vào giỏ</button>}</div></div>}</div>