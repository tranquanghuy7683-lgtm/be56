<!DOCTYPE html><html lang="vi"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>@ViewBag.Title - MyStore</title><link href="@Url.Content("~/Content/bootstrap.css")" rel="stylesheet"/><link href="@Url.Content("~/Content/customer.css")" rel="stylesheet"/></head><body><div class="topbar">Chào mừng đến MyStore - Mua sắm trực tuyến</div><nav class="navbar navbar-default"><div class="container"><div class="navbar-header"><a class="navbar-brand" href="@Url.Action("Index","Home")">MYSTORE</a></div><ul class="nav navbar-nav"><li><a href="@Url.Action("Index","Home")">Trang chủ</a></li><li class="dropdown"><a href="#" class="dropdown-toggle" data-toggle="dropdown">Danh mục <span class="caret"></span></a><ul class="dropdown-menu">@Html.Action("Categories","Home")</ul></li></ul><ul class="nav navbar-nav navbar-right"><li><a href="@Url.Action("Index","Cart")">Giỏ hàng</a></li>@if(Request.IsAuthenticated){<li><a href="@Url.Action("ProfileInfo","Account")">Tài khoản</a></li><li><a href="@Url.Action("OrderHistory","Order")">Đơn hàng</a></li><li>@using(Html.BeginForm("Logout","Account",FormMethod.Post,new { @class="logout-form" })){@Html.AntiForgeryToken()<button class="btn btn-link navbar-btn" type="submit">Đăng xuất</button>}</li>}else{<li><a href="@Url.Action("Login","Account")">Đăng nhập</a></li><li><a href="@Url.Action("Register","Account")">Đăng ký</a></li>}</ul></div></nav><main class="container">@if(TempData["Message"]!=null){<div class="alert alert-success">@TempData["Message"]</div>}@RenderBody()</main><footer class="footer"><div class="container">© MyStore - Website bán hàng ASP.NET MVC 5</div></footer><script src="@Url.Content("~/Scripts/jquery-3.4.1.min.js")"></script><script src="@Url.Content("~/Scripts/bootstrap.min.js")"></script>@RenderSection("scripts",required:false)</body></html>