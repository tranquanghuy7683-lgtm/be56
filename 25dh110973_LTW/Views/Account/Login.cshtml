@model _25dh110973_LTW.Models.ViewModel.LoginVM
@{ViewBag.Title="Đăng nhập";Layout="~/Views/Shared/_CustomerLayout.cshtml";}<div class="form-box"><h2>Đăng nhập</h2>@using(Html.BeginForm()){@Html.AntiForgeryToken()@Html.Hidden("returnUrl",(string)ViewBag.ReturnUrl)@Html.ValidationSummary(false,"",new{@class="text-danger"})<div class="form-group"><label>Tên đăng nhập</label>@Html.TextBoxFor(x=>x.Username,new{@class="form-control"})</div><div class="form-group"><label>Mật khẩu</label>@Html.PasswordFor(x=>x.Password,new{@class="form-control"})</div><button class="btn btn-primary">Đăng nhập</button> <a href="@Url.Action("Register")">Đăng ký</a>}</div>