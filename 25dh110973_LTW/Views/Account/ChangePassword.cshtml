@model _25dh110973_LTW.Models.ViewModel.ChangePasswordVM
@{ViewBag.Title="Đổi mật khẩu";Layout="~/Views/Shared/_CustomerLayout.cshtml";}<div class="form-box"><h2>Đổi mật khẩu</h2>@using(Html.BeginForm()){@Html.AntiForgeryToken()@Html.ValidationSummary(false,"",new{@class="text-danger"})<div class="form-group"><label>Mật khẩu cũ</label>@Html.PasswordFor(x=>x.OldPassword,new{@class="form-control"})</div><div class="form-group"><label>Mật khẩu mới</label>@Html.PasswordFor(x=>x.NewPassword,new{@class="form-control"})</div><div class="form-group"><label>Xác nhận mật khẩu</label>@Html.PasswordFor(x=>x.ConfirmPassword,new{@class="form-control"})</div><button class="btn btn-primary">Đổi mật khẩu</button>}</div>