@model _25dh110973_LTW.Models.ViewModel.RegisterVM
@{ViewBag.Title="Đăng ký";Layout="~/Views/Shared/_CustomerLayout.cshtml";}<div class="form-box"><h2>Đăng ký tài khoản</h2>@using(Html.BeginForm()){@Html.AntiForgeryToken()@Html.ValidationSummary(false,"",new{@class="text-danger"})foreach(var field in new[]{"Username","Password","ConfirmPassword","CustomerName","CustomerPhone","CustomerEmail","CustomerAddress"}){<div class="form-group"><label>@field</label>@if(field.Contains("Password")){<input type="password" name="@field" class="form-control" required/>}else{<input name="@field" class="form-control" required/>}</div>}<button class="btn btn-primary">Đăng ký</button> <a href="@Url.Action("Login")">Đăng nhập</a>}</div>