@model _25dh110973_LTW.Models.ViewModel.ProfileVM
@{ViewBag.Title="Thông tin tài khoản";Layout="~/Views/Shared/_CustomerLayout.cshtml";}<div class="form-box"><h2>Thông tin tài khoản: @Model.Username</h2>@using(Html.BeginForm()){@Html.AntiForgeryToken()@Html.ValidationSummary(false,"",new{@class="text-danger"})<div class="form-group"><label>Họ tên</label>@Html.TextBoxFor(x=>x.CustomerName,new{@class="form-control"})</div><div class="form-group"><label>Điện thoại</label>@Html.TextBoxFor(x=>x.CustomerPhone,new{@class="form-control"})</div><div class="form-group"><label>Email</label>@Html.TextBoxFor(x=>x.CustomerEmail,new{@class="form-control"})</div><div class="form-group"><label>Địa chỉ</label>@Html.TextBoxFor(x=>x.CustomerAddress,new{@class="form-control"})</div><button class="btn btn-primary">Lưu thay đổi</button> <a href="@Url.Action("ChangePassword")">Đổi mật khẩu</a>}</div>