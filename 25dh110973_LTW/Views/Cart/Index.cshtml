@model List<_25dh110973_LTW.Models.ViewModel.CartItem>
@{ViewBag.Title="Giỏ hàng";Layout="~/Views/Shared/_CustomerLayout.cshtml";}<h2>Giỏ hàng</h2>@if(!Model.Any()){<p>Giỏ hàng đang trống. <a href="@Url.Action("Index","Home")">Tiếp tục mua sắm</a></p>}else{<table class="table table-bordered"><tr><th>Sản phẩm</th><th>Giá</th><th>Số lượng</th><th>Thành tiền</th><th></th></tr>@foreach(var x in Model){<tr><td>@x.ProductName</td><td>@x.Price.ToString("N0") đ</td><td>@using(Html.BeginForm("Update","Cart",FormMethod.Post)){@Html.AntiForgeryToken()<input type="hidden" name="id" value="@x.ProductID"/><input type="number" name="quantity" value="@x.Quantity" min="0" max="99" style="width:65px"/><button class="btn btn-default btn-sm">Cập nhật</button>}</td><td>@x.Total.ToString("N0") đ</td><td>@using(Html.BeginForm("Remove","Cart",FormMethod.Post)){@Html.AntiForgeryToken()<input type="hidden" name="id" value="@x.ProductID"/><button class="btn btn-danger btn-sm">Xóa</button>}</td></tr>}</table><h3>Tổng cộng: @Model.Sum(x=>x.Total).ToString("N0") đ</h3><a class="btn btn-success" href="@Url.Action("Checkout","Order")">Đặt hàng</a>}